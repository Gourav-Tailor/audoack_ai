SECRET_KEY=replace-with-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,audoack.in,www.audoack.in
CSRF_TRUSTED_ORIGINS=https://audoack.in,https://www.audoack.in

DB_NAME=audoack_db
DB_USER=audoack_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable

HF_TOKEN=replace-with-huggingface-token

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_QUEUE=celery

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET_NAME=autoace-media
MINIO_REGION=us-east-1
MINIO_ADDRESSING_STYLE=path
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_ENDPOINT_URL=https://audoack.in
MINIO_PRESIGNED_URL_EXPIRE=3600
MINIO_BROWSER_REDIRECT_URL=https://audoack.in:9001
MINIO_API_CORS_ALLOW_ORIGIN=*

BILLING_CURRENCY=INR
BILLING_AUDIO_ANALYSIS_RATE=0.003
BILLING_FAILED_ANALYSIS_RATE=0.001
BILLING_BATCH_RATE=0.001
BILLING_USD_INR_RATE=90

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

DJANGO_WORKERS=3
CELERY_CONCURRENCY=1
GATEWAY_DB_MAX_CONNS=20
GATEWAY_DB_MIN_CONNS=2
HTTP_PORT=80

# Existing deployment compatibility. Keep these defaults if replacing the
# old autoace_ai Compose deployment in the same VM and you want its data.
POSTGRES_VOLUME=autoace_ai_postgres_data
MINIO_VOLUME=autoace_ai_minio_data
